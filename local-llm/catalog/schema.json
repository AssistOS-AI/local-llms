{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local-llm.catalog/v4",
  "title": "local-llm model catalog",
  "description": "Schema v4. Venus recommendations and historical measurements are separate from eligibility. The runtime also accepts v3 with its original three metadata profiles. Seed catalog entries (read-only, shipped with the agent) and user registry entries share this shape. Sources are keyed by weight format; every runner reads one format, so runners that read the same format share one download. Seed Hugging Face sources must pin commit, size and sha256; user sources are pinned when added. `recommended` and `validated` are keyed by hardware profile (dedicated, unified; DS005), then by runner id. `unified` and `validated` labels come only from the trusted seed (the shipped catalog or the operator's LOCAL_LLM_CATALOG_FILE); a user registry entry carrying either is refused. Entries of earlier schemas are not migrated.",
  "type": "object",
  "required": [
    "schema",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "local-llm.catalog/v4"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "id",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "license": {
          "type": "string",
          "maxLength": 80
        },
        "architecture": {
          "enum": [
            "moe",
            "dense"
          ]
        },
        "totalParams": {
          "type": "string",
          "maxLength": 16
        },
        "activeParams": {
          "type": "string",
          "maxLength": 16
        },
        "contextLength": {
          "type": "integer",
          "minimum": 512
        },
        "requiresJinja": {
          "type": "boolean"
        },
        "mtp": {
          "type": "boolean",
          "description": "The weights carry a multi-token-prediction head, so MTP speculative decoding can be turned on (DS005). A capability, not a measurement; without it MTP is refused."
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "Keyed by weight format: gguf is a single GGUF file, or a split GGUF, on Hugging Face (or a registry of kind huggingface or modelscope) or in an OCI registry (read by llama.cpp and ik_llama.cpp); ollama is an Ollama library tag (read by Ollama); hf is a snapshot of safetensors from Hugging Face or CNCF per-file safetensors from an OCI registry (read by vLLM); exl3 is a Hugging Face snapshot of EXL3 weights (read by TabbyAPI).",
          "properties": {
            "gguf": {
              "anyOf": [
                {
                  "$ref": "#/$defs/huggingface"
                },
                {
                  "$ref": "#/$defs/oci"
                }
              ]
            },
            "ollama": {
              "$ref": "#/$defs/ollama"
            },
            "hf": {
              "anyOf": [
                {
                  "$ref": "#/$defs/hfSnapshot"
                },
                {
                  "$ref": "#/$defs/ociSnapshot"
                }
              ]
            },
            "exl3": {
              "$ref": "#/$defs/hfSnapshot"
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layers": {
              "type": "integer",
              "minimum": 1
            },
            "nonExpertBytes": {
              "type": "integer",
              "minimum": 0
            },
            "expertBytesPerLayer": {
              "type": "integer",
              "minimum": 0
            },
            "kvBytesPerToken": {
              "type": "integer",
              "minimum": 1
            },
            "fixedKvBytes": {
              "type": "integer",
              "minimum": 0
            },
            "embeddingBytes": {
              "type": "integer",
              "minimum": 0,
              "description": "The input embedding a runner keeps in system RAM (ExLlamaV3 does)."
            }
          }
        },
        "recommended": {
          "type": "object",
          "additionalProperties": false,
          "description": "Default runner parameters, keyed by hardware profile, then by runner id.",
          "properties": {
            "dedicated": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "unified": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "cpu": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "venus": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "llama.cpp-vulkan": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {
                    "ctxSize": {
                      "type": "integer",
                      "minimum": 512,
                      "maximum": 131072
                    },
                    "parallel": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "loadMode": {
                      "enum": [
                        "auto",
                        "none"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "validated": {
          "type": "object",
          "additionalProperties": false,
          "description": "What was measured on real hardware, keyed by hardware profile, then by runner id. Seed entries only.",
          "properties": {
            "dedicated": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 600
              }
            },
            "unified": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 600
              }
            },
            "cpu": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 600
              }
            },
            "venus": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "llama.cpp-vulkan": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "$ref": "#/$defs/venusMeasurement"
                  }
                }
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "dedicated",
              "unified",
              "cpu"
            ]
          },
          "description": "The hardware profiles in which the model is offered (default: every profile)."
        },
        "sizingSource": {
          "enum": [
            "gguf-header",
            "config.json",
            "manual"
          ],
          "description": "Where contextLength, memory.layers and memory.kvBytesPerToken came from: the GGUF header read at lookup (read again from the verified file after the download), the pinned config.json of a snapshot, or typed by hand. Optional; gguf-header needs a gguf source and config.json an hf or exl3 source."
        },
        "unified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envelope"
          ],
          "description": "The unified profile's measured envelope (DS005). Parameters inside a rectangle are sized from it; a model without one, or parameters outside it, are sized by estimate. Seed entries only.",
          "properties": {
            "envelope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runner",
                  "loadMode",
                  "maxCtx",
                  "maxParallel",
                  "mtp",
                  "bufferBytes",
                  "transientBytes"
                ],
                "properties": {
                  "runner": {
                    "type": "string"
                  },
                  "loadMode": {
                    "enum": [
                      "dio",
                      "none"
                    ],
                    "description": "The load mode this rectangle was measured with; it admits only that mode. A mode measured separately is a rectangle of its own."
                  },
                  "maxCtx": {
                    "type": "integer",
                    "minimum": 512,
                    "description": "Largest total context (the unified KV pool) measured."
                  },
                  "maxParallel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16,
                    "description": "Most parallel slots measured."
                  },
                  "mtp": {
                    "type": "boolean",
                    "description": "Whether MTP speculative decoding may be on."
                  },
                  "bufferBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Sum of the model, KV, recurrent-state, output and compute buffers llama.cpp logs at this corner (-lv 4), on the GPU and the host."
                  },
                  "transientBytes": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Measured memory beyond those buffers during load, prefill and parallel requests, with the prompt cache at 1 MiB, times 1.25."
                  },
                  "measured": {
                    "type": "string",
                    "maxLength": 600
                  }
                }
              }
            }
          }
        }
      }
    },
    "huggingface": {
      "type": "object",
      "required": [
        "type",
        "repo",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "huggingface"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
          "description": "A registry id from Settings. Left out, the source is on huggingface.co; \"huggingface\" is the same and is normalized away. A named registry needs an explicit revision."
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "file": {
          "type": "string",
          "pattern": "\\.gguf$",
          "description": "A single-file GGUF in the repository."
        },
        "revision": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string"
        },
        "shards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "description": "A split GGUF: every shard in canonical order (<prefix>-0000k-of-0000N.gguf, one directory), each pinned by size and sha256. `file` is then the first shard, `size` their sum, and there is no top-level sha256.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "size",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      },
      "if": {
        "required": [
          "registry"
        ],
        "properties": {
          "registry": {
            "not": {
              "const": "huggingface"
            }
          }
        }
      },
      "then": {
        "required": [
          "revision"
        ]
      }
    },
    "ollama": {
      "type": "object",
      "required": [
        "type",
        "tag"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ollama"
        },
        "tag": {
          "type": "string",
          "description": "An Ollama library tag such as gpt-oss:20b."
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hfSnapshot": {
      "type": "object",
      "required": [
        "type",
        "repo"
      ],
      "additionalProperties": false,
      "description": "Every top-level model file (.json, .safetensors, .txt, .model, .tiktoken, .jinja) of a repository at one commit. Seed entries pin commit and files; size is their sum.",
      "properties": {
        "type": {
          "const": "hf-snapshot"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
          "description": "A registry id from Settings. Left out, the source is on huggingface.co; \"huggingface\" is the same and is normalized away. A named registry needs an explicit revision."
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "revision": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "path",
              "size"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}\\.(json|safetensors|txt|model|tiktoken|jinja)$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "The LFS sha256."
              },
              "gitOid": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "The git blob oid of a file kept in git."
              }
            }
          }
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "quantization": {
          "type": "string"
        }
      },
      "if": {
        "required": [
          "registry"
        ],
        "properties": {
          "registry": {
            "not": {
              "const": "huggingface"
            }
          }
        }
      },
      "then": {
        "required": [
          "revision"
        ]
      }
    },
    "oci": {
      "type": "object",
      "required": [
        "type",
        "registry",
        "repository",
        "tag"
      ],
      "additionalProperties": false,
      "description": "A GGUF file, or every shard of a split GGUF, from an OCI image manifest: the legacy Docker dialect (layers application/vnd.docker.ai.gguf.v3, named model.gguf or model-0000k-of-0000N.gguf in layer order) or CNCF ModelPack (layers application/vnd.cncf.model.weight.v1.raw named by org.cncf.model.filepath). A pinned source has manifestDigest, layout, file, size and sha256, or shards; a layer's digest is the sha256 of the file.",
      "properties": {
        "type": {
          "const": "oci"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
          "description": "The id of a registry of kind oci (dockerhub, ghcr, or one an administrator added)."
        },
        "repository": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:\\/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*){1,3}$",
          "description": "2-4 lowercase path segments with an explicit namespace, such as ai/smollm2."
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The image manifest the source is pinned to; its body must hash to it."
        },
        "layout": {
          "enum": [
            "docker",
            "cncf"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "\\.gguf$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "quantization": {
          "type": "string"
        },
        "shards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "description": "A split GGUF: every shard in canonical order, each pinned by size and sha256.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "size",
              "sha256"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "ociSnapshot": {
      "type": "object",
      "required": [
        "type",
        "registry",
        "repository",
        "tag"
      ],
      "additionalProperties": false,
      "description": "CNCF per-file safetensors from an OCI image manifest: the top-level model files (.json, .safetensors, .txt, .model, .tiktoken, .jinja) its layers name, at least one .safetensors. A pinned source has manifestDigest and files; size is their sum.",
      "properties": {
        "type": {
          "const": "oci-snapshot"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
          "description": "The id of a registry of kind oci (dockerhub, ghcr, or one an administrator added)."
        },
        "repository": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:\\/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*){1,3}$",
          "description": "2-4 lowercase path segments with an explicit namespace, such as ai/smollm2."
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "The image manifest the source is pinned to; its body must hash to it."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}\\.(json|safetensors|txt|model|tiktoken|jinja)$"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "venusParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ctxSize",
        "parallel",
        "loadMode"
      ],
      "properties": {
        "ctxSize": {
          "type": "integer",
          "minimum": 512,
          "maximum": 131072
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "loadMode": {
          "enum": [
            "auto",
            "none"
          ]
        }
      }
    },
    "venusMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "measuredAt",
        "evidence",
        "modelSource",
        "configuration"
      ],
      "properties": {
        "schema": {
          "const": "local-llm.venus-measurement/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "manifestSha256",
            "reference"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        "modelSource": {
          "type": "object",
          "required": [
            "type",
            "repo",
            "file",
            "commit",
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "huggingface"
            },
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
            },
            "file": {
              "type": "string",
              "pattern": "\\.gguf$",
              "description": "A single-file GGUF in the repository."
            },
            "revision": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "quantization": {
              "type": "string"
            },
            "shards": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "description": "A split GGUF: every shard in canonical order (<prefix>-0000k-of-0000N.gguf, one directory), each pinned by size and sha256. `file` is then the first shard, `size` their sum, and there is no top-level sha256.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "shards"
              ]
            }
          ]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "params",
            "resolvedThreads",
            "hostChip",
            "hostRamBytes",
            "vmCpus",
            "vmRamBytes"
          ],
          "properties": {
            "params": {
              "$ref": "#/$defs/venusParams"
            },
            "resolvedThreads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "hostChip": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "hostRamBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
